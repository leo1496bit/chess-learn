# Clé API Anthropic : serveur uniquement, ne jamais préfixer par NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (la clé publishable peut être exposée au navigateur ; la RLS protège les données)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Jeton Lichess (optionnel, serveur uniquement) : jeton sans aucune autorisation, lichess.org/account/oauth/token
LICHESS_TOKEN=
