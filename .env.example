# Clé API Anthropic : serveur uniquement, ne jamais préfixer par NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (la clé publishable peut être exposée au navigateur ; la RLS protège les données)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Seule adresse autorisée à se connecter
ALLOWED_EMAIL=vous@example.com

# Identifiant Chess.com par défaut
CHESSCOM_USERNAME=Leny_l
